{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?getepo\\.com"
        }
      ],
      "destination": "https://sendput.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sendput8f92a1c4b7e34d12a9c8e5f102938475.txt", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/epo-edge.js", "destination": "/api/index.js" },
    { "source": "/sf-edge.js", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/mcp/(.*)", "destination": "/api/index.js" },
    { "source": "/verified/(.*)", "destination": "/api/index.js" },
    { "source": "/badge/(.*)", "destination": "/api/index.js" },
    { "source": "/terms", "destination": "/api/index.js" },
    { "source": "/privacy", "destination": "/api/index.js" },
    { "source": "/dmca", "destination": "/api/index.js" },
    { "source": "/license", "destination": "/api/index.js" },
    { "source": "/schema.json", "destination": "/api/index.js" },
    { "source": "/validator", "destination": "/validator.html" },
    { "source": "/(.*)\\.map", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Powered-By", "value": "SendPut EPO Engine" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
