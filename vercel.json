{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sf-edge.js", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/mcp/(.*)", "destination": "/api/index.js" },
    { "source": "/verified/(.*)", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Powered-By", "value": "SendPut AI SignalForge 3.0" }
      ]
    }
  ]
}
