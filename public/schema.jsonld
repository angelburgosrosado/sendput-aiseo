    },
    {
      "@type": "FAQPage",
      "@id": "https://sendput.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Sendput?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sendput is an autonomous information routing and telemetry engine. It embodies the principle of sending information and putting it where it works across client apps, AI agents, and persistent databases."
          }
        },
        {
          "@type": "Question",
          "name": "How does Sendput optimize web applications for AI search engines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sendput crawls web surfaces, generates high-density /llms.txt feeds, synthesizes valid Schema.org graphs, and continuously monitors brand visibility and citation rank across Gemini, Claude, OpenAI, and Perplexity."
          }
        },
        {
          "@type": "Question",
          "name": "How does the Sendput client telemetry beacon operate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sendput provides a zero-dependency JavaScript beacon that captures runtime errors, unhandled promise rejections, Core Web Vitals (TTFB, DOMContentLoaded, Load, FCP), and network fetch degradations, streaming events directly into SQLite with WAL mode."
          }
        }
      ]
    }
  ]
