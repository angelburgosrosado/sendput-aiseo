{
  "name": "sendput-ai-signalforge-3",
  "version": "3.0.0",
  "description": "SendPut AI (SignalForge 3.0) — Active AI Search Visibility, Knowledge Graph Write-Back & Multi-Protocol MCP Node for SMBs and Agencies",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.cjs --external:pg-native",
    "start": "node dist/server.cjs",
    "db:migrate": "psql $DATABASE_URL -f sql/sendput_schema.sql"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
