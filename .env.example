# ==============================================================================
# SignalForge - Enterprise Search & AI Discovery Intelligence
# Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://signalforge:signalforge_secret@localhost:5432/signalforge_db?schema=public"
DIRECT_URL="postgresql://signalforge:signalforge_secret@localhost:5432/signalforge_db?schema=public"

# Application Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="signalforge-production-grade-mock-secret-key-32chars"
SIGNALFORGE_ENV="development"
ENABLE_DEMO_SEED="true"
USE_MOCK_FALLBACK="true"

# Data Provider Adapters (Authorized & Licensed Integrations)
# Note: In accordance with SignalForge ethics principles, only licensed APIs
# and customer-authorized data streams are queried. No scraping or competitor reverse engineering.

# Google Search Console (OAuth 2.0)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""

# Google Analytics 4 (Measurement Protocol)
GOOGLE_ANALYTICS_PROPERTY_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""

# Bing Webmaster Tools API
BING_WEBMASTER_API_KEY=""

# DataForSEO (Licensed SERP & Keyword Index)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# SerpAPI (Official Licensed Search Engine API)
SERPAPI_API_KEY=""

# Google Business Profile API (Local Visibility)
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=""

# Licensed Custom Crawler Service
LICENSED_CRAWLER_ENDPOINT=""
LICENSED_CRAWLER_TOKEN=""
